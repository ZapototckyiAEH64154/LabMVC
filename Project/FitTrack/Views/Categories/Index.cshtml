@model IEnumerable<Category>
@{
    ViewData["Title"] = "Kategorie";
}

<h1>Kategorie treningów</h1>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <p><a class="btn btn-primary" asp-action="Create">+ Nowa kategoria</a></p>
}

<table class="table table-hover">
    <thead class="table-light">
        <tr><th>Nazwa</th><th>Opis</th><th>Liczba treningów</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Workouts.Count</td>
                <td>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">Edytuj</a>
                        <text> | </text><a asp-action="Delete" asp-route-id="@item.Id">Usuń</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
